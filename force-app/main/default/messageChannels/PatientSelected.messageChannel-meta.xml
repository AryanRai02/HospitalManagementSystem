<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Published when a patient is picked in the search bar</description>
    <isExposed>true</isExposed>
    <lightningMessageFields>
        <description>Selected patient record Id</description>
        <fieldName>patientId</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>Selected patient display name</description>
        <fieldName>patientName</fieldName>
    </lightningMessageFields>
    <masterLabel>Patient Selected</masterLabel>
</LightningMessageChannel>
