# This file is used for Git repositories to specify intentionally untracked files that Git should ignore.
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# Sensitive information
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# ==========================================
# Exclude unrelated Salesforce metadata
# ==========================================

# Keep only HMS custom profiles
/force-app/main/default/profiles/*
!/force-app/main/default/profiles/Doctor_Profile.profile-meta.xml
!/force-app/main/default/profiles/Hospital_Admin.profile-meta.xml
!/force-app/main/default/profiles/Receptionist_Profile.profile-meta.xml

# Keep only HMS custom report type
/force-app/main/default/reportTypes/*
!/force-app/main/default/reportTypes/Billing_Revenue_by_Department.reportType-meta.xml

# Exclude unrelated Salesforce default flow
/force-app/main/default/flows/sfdc_default_ReportExport_Protection_Flow.flow-meta.xml

# Keep only HMS roles and required parent role
/force-app/main/default/roles/*
!/force-app/main/default/roles/CEO.role-meta.xml
!/force-app/main/default/roles/Hospital_Admin.role-meta.xml
!/force-app/main/default/roles/Department_Head.role-meta.xml
!/force-app/main/default/roles/Doctor.role-meta.xml
!/force-app/main/default/roles/Receptionist.role-meta.xml


# Keep only HMS custom object sharing rules
/force-app/main/default/sharingRules/*
!/force-app/main/default/sharingRules/Appointment__c.sharingRules-meta.xml
!/force-app/main/default/sharingRules/Billing__c.sharingRules-meta.xml
!/force-app/main/default/sharingRules/Department__c.sharingRules-meta.xml
!/force-app/main/default/sharingRules/Doctor__c.sharingRules-meta.xml
!/force-app/main/default/sharingRules/Medical_Record__c.sharingRules-meta.xml
!/force-app/main/default/sharingRules/Patient_Procedure__c.sharingRules-meta.xml
!/force-app/main/default/sharingRules/Patient__c.sharingRules-meta.xml
!/force-app/main/default/sharingRules/Procedure__c.sharingRules-meta.xml
